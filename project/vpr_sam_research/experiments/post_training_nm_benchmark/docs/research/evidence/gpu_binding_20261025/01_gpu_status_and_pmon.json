{
  "label": "01_gpu_status_and_pmon",
  "command": "nvidia-smi\nnvidia-smi -L\nnvidia-smi --query-compute-apps=gpu_uuid,pid,process_name,used_gpu_memory --format=csv,noheader\nnvidia-smi pmon -c 3 -d 1\nps -eo pid,ppid,comm,etime\nprintf \"PID namespace: \"\nreadlink /proc/self/ns/pid\nreadlink /proc/1/ns/pid\ncat /proc/1/cgroup\nif command -v fuser >/dev/null; then fuser -v /dev/nvidia0 /dev/nvidiactl /dev/nvidia-uvm 2>&1 || true; fi\nif [ -r /proc/driver/nvidia/clients ]; then cat /proc/driver/nvidia/clients; fi",
