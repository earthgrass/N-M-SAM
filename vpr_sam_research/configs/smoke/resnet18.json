{
  "schema": 1,
  "purpose": "smoke",
  "seed": 17,
  "device": "cpu",
  "threads": 1,
  "deterministic": true,
  "output": "runs/smoke/resnet18",
  "model": "resnet18",
  "data": {
    "kind": "synthetic",
    "root": "data/cifar10",
    "download": false,
    "validation_size": 4,
    "synthetic_train": 8,
    "synthetic_test": 8,
    "augment": true,
    "cutout": 4,
    "workers": 0
  },
  "optimizer": {
    "method": "vpr",
    "lr": 0.01,
    "momentum": 0.9,
    "weight_decay": 0.0005,
    "nesterov": false,
    "rho": 0.02
  },
  "geometry": {
    "gamma": 0.001,
    "dtype": "float64",
    "warmup_steps": 0,
    "volume_atol": 1e-10,
    "volume_rtol": 1e-12,
    "static_std": 0.1
  },
  "training": {
    "epochs": 1,
    "batch_size": 2,
    "scheduler": "cosine",
    "eta_min": 0.0,
    "checkpoint_interval_steps": 0
  },
  "pruning": {
    "n": 1,
    "m": 3,
    "scope": "all",
    "score": "magnitude",
    "tail": "dense"
  },
  "recovery": {
    "epochs": 1,
    "method": "sgd",
    "lr": 0.005,
    "momentum": 0.9,
    "weight_decay": 0.0005,
    "rho": 0.02,
    "scheduler": "cosine",
    "eta_min": 0.0
  },
  "evaluation": {
    "batch_size": 4,
    "probe_rho": 0.02,
    "probe_batches": 1
  }
}
